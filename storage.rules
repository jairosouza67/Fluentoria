rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: user is admin (role field or primary admin email) via Firestore
    function isAdmin() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.email == 'jairosouza67@gmail.com'
        );
    }

    // Profile photos: owner-only write, small images only
    match /profile_photos/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Student media submissions: the student themself or admin, up to 100MB
    match /media/{courseId}/{studentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.auth.uid == studentId || isAdmin())
        && request.resource.size < 100 * 1024 * 1024;
    }

    // Course covers: admin-only write, images up to 10MB
    match /course-covers/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Lesson support materials: admin-only write, up to 50MB
    match /support-materials/{courseId}/{lessonId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024;
    }

    // Default deny: no writes anywhere else
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
